{
  "mcpServers": {
    "tavily": {
      "command": "node",
      "args": ["/absolute/path/to/tavily-mcp-server/dist/index.js"],
      "env": { "TAVILY_API_KEY": "tvly-xxxxxxxxxxxxxxxx" }
    },
    "tavily-web-search": {
      "command": "/absolute/path/to/tavily-mcp-server/.venv/bin/python",
      "args": ["/absolute/path/to/tavily-mcp-server/server.py"]
    }
  }
}
